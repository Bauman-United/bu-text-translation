# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Channel ID where comments will be posted
# To get channel ID:
# 1. Add @RawDataBot to your channel
# 2. It will show you the channel ID (usually starts with -100)
TELEGRAM_CHANNEL_ID=your_telegram_channel_id_here

# Your Telegram User ID for notifications
# Get it by messaging @userinfobot on Telegram
MY_ID=your_telegram_user_id_here

# ---------------------------------------------------------------------------
# VK
# ---------------------------------------------------------------------------

# ID of YOUR OWN VK application (vk.com/apps?act=manage -> Settings).
# Required so the bot can refresh its access token on its own.
# The app must be enabled under Settings -> Placement -> "State for users".
VK_APP_ID=your_vk_app_id_here

# VK authorization.
#
# Preferred: run `python scripts/vk_authorize.py` once. It stores a refreshable
# token set in data/vk_token.json and the bot renews it automatically from then on.
#
# VK_ACCESS_TOKEN below is only a fallback. VK ID removed the `offline`
# permission, so tokens taken from the implicit flow die after 24 hours and the
# bot cannot renew them. Leave it empty once vk_authorize.py has been run.
VK_ACCESS_TOKEN=

# VK Group to monitor for new live streams.
# Accepts a full URL (https://vk.com/club123456789) or a bare numeric ID.
VK_GROUP=your_vk_group_url_or_id_here

# ---------------------------------------------------------------------------
# Other
# ---------------------------------------------------------------------------

# OpenAI key for generated goal commentary. Without it the bot falls back to
# plain "Забиваем! Счет: X-Y" messages.
OPENAI_KEY=your_openai_key_here

# Team name as it appears on the match page, used by site parsing mode
# (/match and the site monitor). Must match the site exactly, e.g. "Bauman United".
# Optional: defaults to "Bauman United".
MATCH_PAGE_TEAM_NAME=Bauman United
